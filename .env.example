# Brasil te Ama — env template. Copy to .env.local and fill in.

# Multi-tenant site id (brasil-te-ama row in public.sites)
NEXT_PUBLIC_SITE_ID=22222222-2222-2222-2222-222222222222

# Canonical base URL (seo.ts → canonical, OG, sitemap).
# Staging: https://brasilteama.alcgestao.com.br | Oficial: https://institutobrasilteama.org
NEXT_PUBLIC_SITE_URL=https://brasilteama.alcgestao.com.br

# Staging guard: "true" emite X-Robots-Tag noindex em todas as rotas.
# Deixar VAZIO/remover no deploy do domínio oficial para liberar a indexação.
NEXT_PUBLIC_NOINDEX=true

# Supabase (shared project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CMS revalidation secret
REVALIDATE_SECRET=

# Sentry (optional; empty = disabled)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
SENTRY_AUTH_TOKEN=

# ZeptoMail (Fase 4) — form notifications. If any of the three below is unset,
# the form still saves to `submissions`; only the notification email is skipped.
ZEPTO_API_TOKEN=
CONTACT_FROM_EMAIL=        # verified sender in ZeptoMail (e.g. site@institutobrasilteama.org)
CONTACT_FROM_NAME=Instituto Brasil te Ama
CONTACT_TO_EMAIL=          # inbox that receives form submissions
