# Brasil te Ama — env template. Copy to .env.local and fill in.

# Multi-tenant site id (brasil-te-ama row in public.sites)
NEXT_PUBLIC_SITE_ID=22222222-2222-2222-2222-222222222222

# Supabase (shared project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CMS revalidation secret
REVALIDATE_SECRET=

# Sentry (optional; empty = disabled)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENV=development
SENTRY_AUTH_TOKEN=

# ZeptoMail (Fase 4)
ZEPTO_API_TOKEN=
